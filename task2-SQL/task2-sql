-- 17: students with a grade greater than 50

create or alter view dbo.students_passed_courses
as
select isnull(s.St_Fname, '') + ' ' + isnull(s.St_Lname, '') as fullname,
       c.Crs_Name
from dbo.Student as s
inner join dbo.Stud_Course as sc
    on s.St_Id = sc.St_Id
inner join dbo.Course as c
    on sc.Crs_Id = c.Crs_Id
where sc.Grade > 50;
go

select *
from dbo.students_passed_courses;
go

-- 18: departments with the maximum number of students

with department_counts as (
    select d.Dept_Id,
           d.Dept_Name,
           count(s.St_Id) as studentcount
    from dbo.Department as d
    left join dbo.Student as s
        on d.Dept_Id = s.Dept_Id
    group by d.Dept_Id, d.Dept_Name
)
select Dept_Name, studentcount
from department_counts
where studentcount = (
    select max(studentcount)
    from department_counts
);
go

-- 19: instructors earning the second-highest distinct salary per department

with ranked_instructors as (
    select Ins_Id,
           Ins_Name,
           Dept_Id,
           Salary,
           dense_rank() over (
               partition by Dept_Id
               order by Salary desc
           ) as salaryrank
    from dbo.Instructor
    where Salary is not null
      and Dept_Id is not null
)
select Ins_Name, Dept_Id, Salary
from ranked_instructors
where salaryrank = 2;
go

-- 20: up to two highest-paid instructors per department

with ranked_instructors as (
    select Ins_Id,
           Ins_Name,
           Dept_Id,
           Salary,
           row_number() over (
               partition by Dept_Id
               order by Salary desc, Ins_Id
           ) as salaryrank
    from dbo.Instructor
    where Salary is not null
      and Dept_Id is not null
)
select Ins_Name, Dept_Id, Salary
from ranked_instructors
where salaryrank <= 2
order by Dept_Id, salaryrank;


       

      


       
